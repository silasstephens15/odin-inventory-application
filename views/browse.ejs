<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head')%>
  <body>
    <%- include('partials/navbar')%>
    <%if (oneCategory==true){;%>
        <h2><%=title%></h2>
        <button type="button" class="delete">Delete Category</button>
        <div class="hidden" style="display: none;"><label for="password">Password</label>
                         <input type="text" name="password" id="password" data-name="<%=title%>">
                        <button type="button" class="hidden delete <%=title%>">Submit Change</button></div>
    <%}%>
    <%if (oneManufacturer==true){;%>
        <h2><%=title%></h2>
        <button type="button" class="delete">Delete Manufacturer</button>
        <div class="hidden" style="display: none;"><label for="password">Password</label>
                         <input type="text" name="password" id="password" data-name="<%=title%>">
                        <button type="button" class="hidden delete <%=title%>">Submit Change</button></div>
    <%}%>
        <% parts.map((part)=>{%>
            <div class="part">
                <ul>
                    <li><%=part.name%></li>
                    <li><%=part.price%></li>
                    <%if (oneManufacturer == false) {%>
                    <li><%=part.manufacturer_name%></li>
                    <%}%>
                    <%if (oneCategory == false) {%>
                    <li><%=part.category_name%></li>
                    <%}%>
                    <li id="<%=part.name%>-selector">Amount: <%=part.amount%></li>
                    <li style="display: none;" class="hidden">
                        <form action="/part/amount" method="POST">
                        <label for="<%=part.name%>"></label>
                        <input 
                        id="<%=part.name%>"
                         name="<%=part.name%>" 
                         type="number" 
                         value="<%=part.amount%>"
                         min="0"/>
                         <label for="password">Password</label>
                         <input type="text" name="password" id="password">
                        <button type="submit">Submit Change</button>
                    </form>
                </li>
                <li><div>
                    <button type="button" class="delete">Delete</button>
                    <div class="hidden" style="display: none;"><label for="password">Password</label>
                         <input type="text" name="password" id="password" data-name="<%=part.name%>">
                        <button type="button" class="hidden delete">Submit Change</button></div>
                </div></li>
                </ul>
            </div>
            <%})%>
    <script>
        const body = document.querySelector('body');

        body.addEventListener('dblclick', (e)=>{
            if (e.target.id.slice(-8) == 'selector'){
                const form = e.target.parentElement.querySelector('.hidden');
                form.style.display = 'block';
                e.target.style.display = 'none';
            };
        });
        body.addEventListener('click', (e)=>{
            if(e.target.classList.contains('delete')){
                const form = e.target.parentElement.querySelector('.hidden');
                form.style.display = 'block';
             if(e.target.classList.contains('hidden') && e.target.type == 'button'){
                const input = e.target.parentElement.querySelector('input');
                if(input.value == ''){
                    alert('Enter password')
                    return
                }
                let endpoint = `/part/${input.dataset.name}&${input.value.replace('/', '%2F')}`
                if (e.target.classList.contains('<%=title%>') && <%=oneManufacturer%>){endpoint = '/manufacturer/'+ '<%=title%>' + `&${input.value.replace('/', '%2F')}`}
                if (e.target.classList.contains('<%=title%>') && <%=oneCategory%>){endpoint = '/category/'+'<%=title%>' + `&${input.value.replace('/', '%2F')}`}
                console.log(endpoint)
                fetch(endpoint, 
                {method: "DELETE"})
                .then((res)=>{
                    const res2 = res.clone()
                    res.json().then((data)=>{window.location.href = data.redirect}).catch(()=>{
                        res2.text().then((html)=>{document.querySelector('html').innerHTML = html})
                    });
                }).catch(err=>console.log(err));
             };
            };
        })
    </script>
  </body>
</html>
