<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head')%>
  <body>
    <%- include('partials/navbar')%>
    <form action="/part/add" method="POST">
      <h2>Add Part</h2>
      <label for="name">Part Name</label>
      <input type="text" name="name" id="name" />
      <label for="price">Price</label>
      <input type="number">
      <fieldset>
        <legend>Select a Manufacturer</legend>
        <%manufacturers.map((manufacturer)=>{%>
            <input type="radio" name="manufacturers" id=<%=manufacturer.name%> value=<%=manufacturer.name%>>
            <label for=<%=manufacturer.name%>><%=manufacturer.name%></label>
        <%})%>
      </fieldset>
      <fieldset>
        <legend>Select a Category</legend>
        <%categories.map((category)=>{%>
            <input type="radio" name="categories" id=<%=category.name%> value=<%=category.name%>>
            <label for=<%=category.name%>><%=category.name%></label>
        <%})%>
      </fieldset>
      <button
        type="button"
        onclick="document.getElementById('modal').style.display = 'block'"
      >
        Submit
      </button>
      <div class="modal" id="modal" style="display: none">
        <label for="password">Enter Password</label>
        <input type="text" name="password" id="password" />
        <button type="submit">Submit</button>
      </div>
    </form>
  </body>
</html>
