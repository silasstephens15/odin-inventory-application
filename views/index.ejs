<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head')%>
  <body>
    <%- include('partials/navbar')%>
    <h2>What Is This Site?</h2>
    <p>
      This is a small application which follows the Odin Project's Inventory
      Application Project. Express is used as well as EJS and PG for view
      templates and PostgreSQL access respectively.
    </p>
    <h2>Product Categories</h2>
    <ul>
      <li><a href="/category/all">Browse All</a></li>
    <% categories.map((category)=>{%>
      <li><a href="/category/<%=category.name%>"><%=category.name%></a></li>
      <%})%>
      <li><a href="/category/add">Add</a></li>
      </ul>
  </body>
</html>
